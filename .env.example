# ====================================================================
# SEO Indexer - Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your local development environment:
#      cp .env.example .env
# 2. Fill in your actual credentials below in '.env'.
# 3. For Vercel or cloud deployments, enter these variable names and
#    their values in your hosting dashboard:
#      Project Settings -> Environment Variables
#
# IMPORTANT:
# - NEVER commit real credentials to .env.example or Git!
# - Real secrets belong only in gitignored '.env' or secure CI/CD secrets.
# ====================================================================

# --------------------------------------------------------------------
# 1. Two-Factor Authentication Security Gates
# --------------------------------------------------------------------
# ADMIN_PASSWORD: Password required for the first authentication gate
ADMIN_PASSWORD=your_admin_password_here

# OTP_CODE: 6-10 digit numeric OTP required for the second authentication gate
OTP_CODE=your_numeric_otp_here

# SESSION_SECRET: High-entropy string used for HMAC-SHA256 session signature verification
SESSION_SECRET=your_random_session_secret_32_characters_or_more

# --------------------------------------------------------------------
# 2. Supabase PostgreSQL & API Configuration
# --------------------------------------------------------------------
# SUPABASE_URL: URL of your Supabase project (from Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_ANON_KEY: Client anon public key (from Project Settings -> API)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SUPABASE_SERVICE_ROLE_KEY: Secret service role key (for backend database operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# DATABASE_URL: Direct or pooled PostgreSQL connection string (Project Settings -> Database)
# e.g., postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-id:your_password@aws-0-region.pooler.supabase.com:5432/postgres

# --------------------------------------------------------------------
# 3. Google Indexing API Rate Limits & Quotas
# --------------------------------------------------------------------
# DAILY_QUOTA_PER_ACCOUNT: Daily quota limit per service account (Google Indexing API default is 200)
DAILY_QUOTA_PER_ACCOUNT=200

# --------------------------------------------------------------------
# 4. Optional Configurations
# --------------------------------------------------------------------
# PORT: Local development server port (defaults to 3000)
# PORT=3000
